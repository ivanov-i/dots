<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ivanov.trashsweeper</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/ivanov/bin/trashsweeper</string>
        <string>--threshold</string>
        <string>10</string>
    </array>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/Users/ivanov/Library/Logs/trashsweeper.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ivanov/Library/Logs/trashsweeper.err.log</string>
</dict>
</plist>
